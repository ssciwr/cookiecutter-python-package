            "LGPL-3.0": "GNU LGPL v3",
            "None": "Do not add a license"
        },
        "github_actions_ci": "Add GitHub Actions CI?",
        "gitlab_ci": "Add GitLab CI?",
        "notebooks": "Add an example Jupyter notebook?",
        "commandlineinterface": "Add a command-line interface?",
        "version_management": {
            "__prompt__": "Package version management",
            "manually": "Set the version manually",
